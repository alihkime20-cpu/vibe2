# Public browser configuration. Keep RLS enabled; never put a service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>
VITE_SITE_ORIGIN=
# Optional when the API is on another origin; leave blank when reverse-proxied under the same host.
VITE_EDITORIAL_API_ORIGIN=
SITE_URL=

# Server-only Editorial API configuration. Never expose these values through Vite.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-key>
EDITORIAL_ADMIN_TOKEN=<long-random-editorial-token>
# Comma-separated production origins; leave empty for same-origin deployment.
CORS_ORIGINS=
PORT=8787
